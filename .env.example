# Copy to .env (git-ignored). Real environment variables override this file.
# Names: UPPERCASE here, lowercase when used (aliases, tenants, providers).
# A value containing spaces MUST be quoted: NEXORA_ALIAS_X="a/m, b/m".
# A malformed .env stops startup (it is never silently ignored).

# --- Server ---
NEXORA_LISTEN=0.0.0.0:8080
NEXORA_ADMIN_LISTEN=127.0.0.1:9090      # metrics/health: never expose publicly
NEXORA_MAX_BODY_BYTES=1048576
NEXORA_LEDGER_PATH=nexora-ledger.db
RUST_LOG=info

# --- Providers: NEXORA_PROVIDER_<NAME>_URL (+ _KEY, _TIMEOUT_MS) ---
# URL includes the version prefix. Any OpenAI-compatible server works.
NEXORA_PROVIDER_OPENAI_URL=https://api.openai.com/v1
NEXORA_PROVIDER_OPENAI_KEY=
NEXORA_PROVIDER_OPENAI_TIMEOUT_MS=60000
NEXORA_PROVIDER_LOCAL_URL=http://localhost:11434/v1     # e.g. Ollama, no key needed

# --- Aliases: clients ask for the alias; targets are tried in order (fallback) ---
# Format: provider/model,provider/model
NEXORA_ALIAS_SMART="openai/REPLACE_ME, local/REPLACE_ME"

# --- Tenants: generate with `nexora keygen` and paste the hash ---
NEXORA_TENANT_SEARCH_KEY_HASH=REPLACE_WITH_64_HEX_FROM_keygen
NEXORA_TENANT_SEARCH_RPM=120
NEXORA_TENANT_SEARCH_TPM=200000
NEXORA_TENANT_SEARCH_MODELS=smart       # allowed aliases; empty = all
NEXORA_TENANT_SEARCH_MAX_CONCURRENT=64  # simultaneous requests (streams count until they end)
NEXORA_TENANT_SEARCH_DAILY_BUDGET_USD=50      # hard cap per UTC day; optional
NEXORA_TENANT_SEARCH_MONTHLY_BUDGET_USD=1000  # hard cap per calendar month; optional
# A budget requires a price for EVERY model the tenant can reach (see NEXORA_PRICES),
# otherwise startup fails: an unpriced model would silently never count against the budget.

# --- Admin API (tenants and keys without a restart), control-plane port only ---
# Unset = disabled (404). Use a long random value, e.g. the output of `nexora keygen`.
# NEXORA_ADMIN_TOKEN=

# --- Prices, USD per 1M tokens: provider/model=input:output ---
NEXORA_PRICES=openai/REPLACE_ME=0:0
